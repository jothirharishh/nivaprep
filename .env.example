# ─── Backend environment configuration ───────────────────────────────────────
# Copy this file to .env and fill in real values locally.
# NEVER commit .env or any file containing real secrets.

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Flask
FLASK_SECRET_KEY=change_this_to_a_random_secret
FLASK_ENV=development
FLASK_DEBUG=1

# Admin endpoint protection
ADMIN_API_KEY=change_this_admin_key

# Database
DATABASE_PATH=backend/data/boardmate.db

# Embedding model (sentence-transformers model name or API)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# FAISS index storage
FAISS_INDEX_PATH=backend/rag/indexes/

# Generation settings
GROQ_MAX_RETRIES=3
GROQ_TIMEOUT_SECONDS=30
MAX_RETRIEVAL_CHUNKS=6
